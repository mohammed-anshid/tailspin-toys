---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="space-y-6">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <label for="game-sort" class="text-sm font-medium text-slate-300">Sort games</label>
            <select
              id="game-sort"
              class="rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="game-sort"
            >
              <option value="title-asc">Title (A-Z)</option>
              <option value="title-desc">Title (Z-A)</option>
            </select>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
          </div>
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  const sortSelect = document.querySelector<HTMLSelectElement>('[data-testid="game-sort"]');
  const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');

  function getCardTitle(card: HTMLElement): string {
    return card.dataset.gameTitle ?? '';
  }

  function compareTitle(firstTitle: string, secondTitle: string): number {
    return firstTitle.localeCompare(secondTitle, undefined, { sensitivity: 'base' });
  }

  if (sortSelect && gamesGrid) {
    const gameCards = Array.from(gamesGrid.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

    sortSelect.addEventListener('change', () => {
      const sortMode = sortSelect.value;
      const sortedCards = [...gameCards].sort((firstCard, secondCard) => {
        const firstTitle = getCardTitle(firstCard);
        const secondTitle = getCardTitle(secondCard);
        const titleComparison = compareTitle(firstTitle, secondTitle);

        return sortMode === 'title-desc' ? -titleComparison : titleComparison;
      });

      gamesGrid.replaceChildren(...sortedCards);
    });
  }
</script>
